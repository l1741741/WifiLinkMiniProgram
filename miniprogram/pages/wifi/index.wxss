.row__pwd {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}
.eye {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  opacity: .55;
}
.eye--on { opacity: 1; }

/* ---------------------------------------------------------------- 按钮 */
.btn--big { margin-top: 28rpx; }
.btn--m { margin-top: 18rpx; padding: 26rpx; font-size: 30rpx; }

/* ---------------------------------------------------------------- 状态 */
.status {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.65;
  text-align: center;
}
.status--working { background: #eef4ff; color: #1e51d8; }
.status--connected { background: #e8f8ef; color: #0a7c46; }
.status--failed { background: #fef3f2; color: #b42318; }

/* ---------------------------------------------------------------- 步骤 */
.way {
  margin-top: 40rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx 32rpx;
}
.way__tag {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 600;
  color: #2f6bff;
  background: #e8efff;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  margin-bottom: 22rpx;
}
.step {
  position: relative;
  padding-left: 34rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: #475467;
  margin-bottom: 12rpx;
}
.step::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 20rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #cfd8e6;
}
.step-tip {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  background: #f8fafc;
  border-left: 6rpx solid #cbd5e1;
  border-radius: 0 14rpx 14rpx 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: #667085;
}

/* 服务说明入口 */
.more {
  margin-top: 44rpx;
  text-align: center;
  font-size: 25rpx;
  color: #98a2b3;
  padding: 20rpx;
}
.more:active { color: #2f6bff; }
